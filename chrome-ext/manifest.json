{
  "manifest_version": 3,
  "name": "bp-scraper extension",
  "version": "1.0",
  "description": "Sends scraped data to the site where it's displayed.",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://backpack.tf/*",
    "https://*.backpack.tf/*",
    "http://*.backpack.tf/*",
    "http://backpack.tf/*",
    "http://localhost:8001/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}